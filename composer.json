{
    "name": "wavykit/monorepo",
    "description": "Development install for the WavyKit monorepo. Not published.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "wavykit/core": "0.2.x-dev",
                    "wavykit/inertia": "0.2.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "wavykit/core": "^0.2@dev",
        "wavykit/inertia": "^0.2@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "monorepo-php/monorepo": "^12.7",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "WavyKit\\Tests\\": "packages/core/tests/",
            "WavyKit\\Inertia\\Tests\\": "packages/inertia/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "check": "bin/check",
        "format": "bin/format",
        "format:check": "bin/check --only=format",
        "analyse": "bin/check --only=analyse",
        "test": "bin/check --only=test"
    },
    "scripts-descriptions": {
        "check": "Validate manifests, then run Pint, PHPStan, and Pest in each package (pass package names to limit).",
        "format": "Apply Pint formatting in each package (pass package names to limit).",
        "format:check": "Verify Pint formatting in each package without modifying files.",
        "analyse": "Run PHPStan at maximum level in each package.",
        "test": "Run Pest in each package."
    }
}
