includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Report calls to WavyKit's @internal members, as an outside adopter would see them.
    featureToggles:
        internalTag: true
