{
    "name": "current/livewire-context-prototype",
    "description": "Throwaway HTTP lifecycle proof; not a Current integration.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "13.42.0",
        "livewire/livewire": "4.4.9",
        "current/current": "^0.5@dev"
    },
    "autoload": {
        "psr-4": {
            "Prototype\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/current",
            "options": {
                "symlink": true,
                "versions": {
                    "current/current": "0.5.x-dev"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "license": "MIT"
}
